PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=*

# Use either DATABASE_URL or the individual PG* settings below.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/internguide
PGSSL=false

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Optional local upload directory. Defaults to backend/uploads/resumes.
UPLOAD_DIR=

PGHOST=localhost
PGPORT=5432
PGDATABASE=internguide
PGUSER=postgres
PGPASSWORD=postgres

# Optional local-only demo seed values. Change these before any shared or deployed use.
DEMO_UNIVERSITY_NAME=InternGuide Demo University
DEMO_UNIVERSITY_DOMAIN=demo.edu
DEMO_UNIVERSITY_LOCATION=Beirut
DEMO_UNIVERSITY_CONTACT_EMAIL=admin@demo.edu
DEMO_DEPARTMENT_NAME=Computer Science
DEMO_SYSTEM_ADMIN_EMAIL=system.admin@internguide.local
DEMO_SYSTEM_ADMIN_PASSWORD=ChangeMeSystemAdmin123!
DEMO_UNIVERSITY_ADMIN_EMAIL=university.admin@demo.edu
DEMO_UNIVERSITY_ADMIN_PASSWORD=ChangeMeUniversityAdmin123!

NODE_ENV=production
DATABASE_URL=
PGSSL=true
JWT_SECRET=
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=https://omar-omarr.github.io

# Must point to a persistent disk/volume mount.
# Render: /var/data/resumes
# Railway with a volume mounted at /data: /data/resumes
UPLOAD_DIR=
# Optional. Defaults to a reports folder beside UPLOAD_DIR.
REPORT_UPLOAD_DIR=

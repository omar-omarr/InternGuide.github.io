{
  "name": "internguide-backend",
  "version": "1.0.0",
  "description": "Express and PostgreSQL API for the InternGuide MVP.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:init": "node db/scripts/run_sql_file.js db/schema.sql",
    "migrate:admin-foundation": "node db/scripts/run_sql_file.js db/migrations/20260603_add_admin_university_foundation.sql",
    "migrate:university-admin-indexes": "node db/scripts/run_sql_file.js db/migrations/20260603_add_university_admin_indexes.sql",
    "seed:admin-university": "node db/seeds/seed_admin_university.js",
    "seed:demo-system-admin": "node db/seeds/seed_demo_system_admin.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}

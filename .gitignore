# Local environment files
.env
.env.*
!.env.example
!.env.production.example
backend/.env
backend/.env.*
!backend/.env.example
!backend/.env.production.example

# Dependencies
node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime uploads and logs
backend/uploads/resumes/*
!backend/uploads/resumes/.gitkeep
backend/logs/*
!backend/logs/.gitkeep
logs/*
!logs/.gitkeep

# Browser/test artifacts
test-artifacts/*
!test-artifacts/.gitkeep

# Generated output and temporary directories
coverage/
dist/
build/
.cache/
tmp/
temp/

# Local-only files that must never be committed
/Final Report Bau internships platform.docx
/link.txt
/logs/
/test-artifacts/
/uploads/
/backend/uploads/
*.log

